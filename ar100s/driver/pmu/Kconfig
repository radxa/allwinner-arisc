	bool "AXP858 used"

config AXP8191_USED
	bool "AXP8191 used"

config PMU_EXT_USED
	bool "pmu_ext used"

endif # PMU_USED

if BMU_USED

config ETA6973_USED
	bool "bmu eta6973 used"

config AXP519_USED
	bool "bmu axp519 used"

endif # BMU_USED
